on post-fs
    start boot-qti

service boot-qti /system/bin/android.hardware.boot-service.qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0
