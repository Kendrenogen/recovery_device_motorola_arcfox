on property:hwservicemanager.ready=true && property:vendor.sys.listeners.registered=true
    start keymint-qti
    start keymint-strongbox

service keymint-strongbox /system/bin/android.hardware.security.keymint-service.strongbox-thales
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0
